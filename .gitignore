# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Python
# Keep __pycache__/ and *.pyc out of the tree so `git rebase origin/staging`
# works on branches that have just run pytest, without needing
# `git stash && git rebase && git stash pop`. Matches all bytecodes produced
# by cpython 3.x regardless of optimization level.
__pycache__/
__pycache__/**
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/
dist/
build/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
kubeconfig*
!kubeconfig.example

# Local development
.local/
tmp/

# Wiki data (keep structure, ignore content)
data/pages/*.md

# Local plans (not for version control)
docs/prd/003-agent-factory.md
