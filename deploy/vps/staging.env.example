# MeshWiki STAGING environment variables
# Copy this to /opt/meshwiki/staging.env on the VPS and fill in values.
# Staging runs from a live git checkout with --reload; changes take effect instantly on git pull.
# Never commit the real staging.env file.

# ── App ──────────────────────────────────────────────────────
MESHWIKI_DATA_DIR=/data/pages

# ── Auth ─────────────────────────────────────────────────────
# With auth enabled the app REFUSES TO START until both values below are set.
# They are left blank on purpose so an unedited copy of this file cannot run.
# The staging deploy job fails if /opt/meshwiki/staging.env is missing; it never
# installs this example for you.
MESHWIKI_AUTH_ENABLED=true
# REQUIRED. Plaintext password for single-user login. Must be non-empty and
# not one of the old example values ("changeme", "staging").
MESHWIKI_AUTH_PASSWORD=
# REQUIRED. Session cookie signing key, at least 32 characters. Anyone who
# knows it can forge a login, so generate a fresh one (do not reuse production's):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MESHWIKI_SESSION_SECRET=

# ── Agent Factory ────────────────────────────────────────────
# Keep factory disabled on staging by default to avoid grinders running
# against the staging wiki. Enable only when testing factory features.
MESHWIKI_FACTORY_ENABLED=false
MESHWIKI_FACTORY_API_KEY=
# orchestrator-staging listens on 8002 (CI writes FACTORY_PORT=8002).
MESHWIKI_FACTORY_WEBHOOK_URL=http://orchestrator-staging:8002/webhook
MESHWIKI_FACTORY_WEBHOOK_SECRET=

# ── GitHub Integration ───────────────────────────────────────
# HMAC secret for verifying inbound GitHub webhooks (PR merged events).
# Must match the secret configured on the GitHub repo webhook.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
MESHWIKI_GITHUB_WEBHOOK_SECRET=
