# MeshWiki runtime environment variables
# Copy this to /opt/meshwiki/.env on the VPS and fill in values.
# Never commit the real .env file.

# ── App ──────────────────────────────────────────────────────
MESHWIKI_DATA_DIR=/data/pages

# ── Auth (M0.3) ───────────────────────────────────────────────
# With auth enabled the app REFUSES TO START until both values below are set.
# They are left blank on purpose so an unedited copy of this file cannot run.
MESHWIKI_AUTH_ENABLED=true
# REQUIRED. Plaintext password for single-user login. Must be non-empty and
# not one of the old example values ("changeme", "staging").
MESHWIKI_AUTH_PASSWORD=
# REQUIRED. Session cookie signing key, at least 32 characters. Anyone who
# knows it can forge a login, so generate a fresh one per environment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MESHWIKI_SESSION_SECRET=

# ── Agent Factory (Phase 1+) ──────────────────────────────────
MESHWIKI_FACTORY_ENABLED=false
# Static Bearer token for orchestrator → wiki API calls.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Also add as MESHWIKI_FACTORY_API_KEY in GitHub Secrets for CI use.
MESHWIKI_FACTORY_API_KEY=
MESHWIKI_FACTORY_WEBHOOK_URL=
MESHWIKI_FACTORY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
POSTGRES_DSN=postgresql://meshwiki:changeme@db:5432/meshwiki
